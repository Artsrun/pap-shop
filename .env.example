# Commission form → email via https://resend.com
# Without RESEND_API_KEY the form answers 503 and offers a prefilled email instead.
RESEND_API_KEY=
COMMISSION_TO=rubenpappottery@gmail.com
# Needs a domain verified in Resend; the default onboarding sender only delivers to the Resend account owner.
COMMISSION_FROM="Ruben Pap website <studio@example.com>"

# Absolute URL for canonical links + sitemap. On Vercel the production URL is used automatically.
SITE_URL=
